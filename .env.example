# ---------------------------------------------------------------------------
# Multi-Agent Deep Research System - Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env and put your real keys in .env ONLY.
# This file is committed to git: never put a real key in it.

# --- Supabase: accounts and database (required) ---
# Project URL only, e.g. https://abcdefgh.supabase.co (no /rest/v1 on the end)
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API Keys: publishable key (sb_publishable_...) or legacy anon key
SUPABASE_ANON_KEY=your_supabase_publishable_key_here
# Project Settings > API Keys: secret key (sb_secret_...) or legacy service_role key.
# Server-side only. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
# Comma-separated emails that become administrators when they sign in
ADMIN_EMAILS=you@example.com
# Public URL of this app; auth emails link back to it
SITE_URL=http://localhost:8000

# --- LLM providers (at least one required) ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Search (recommended) ---
# Without it, a keyless fallback is used, which public search engines often throttle.
TAVILY_API_KEY=your_tavily_api_key_here

# --- Observability (optional) ---
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here

# --- Overrides (optional) ---
# Any settings.yaml value can be overridden with an upper-case variable.
# LOG_LEVEL=DEBUG
# REQUIRE_HUMAN_APPROVAL=true    # Pause each run for approval before analysis
# RATE_LIMIT_PER_MINUTE=10       # Research starts per user per minute (0 disables)
# MAX_QUERY_LENGTH=500
# MOCK_MODE=true                 # Tests and demos only: canned agents, no API calls
